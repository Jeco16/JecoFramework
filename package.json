{
  "name": "JecoFramework",
  "version": "0.9.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "pretest": "node -e \"if (process.env.CREATE_PLAYWRIGHT_REPORT==='true') require('fs').mkdirSync('./playwright-report',{recursive:true});\"",
    "test": "npx playwright test --project=e2e --project=api",
    "test:e2e": "npx playwright test --project=e2e",
    "test:api": "npx playwright test --project=api",
    "test:headed": "npx playwright test --headed",
    "test:debug": "cross-env PWDEBUG=1 npx playwright test",
    "show-report": "npx playwright show-report",
    "install:browsers": "npx playwright install",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "selftest": "npx playwright test --project=self --reporter=list --workers=1",
    "docs": "typedoc"
    ,"scaffold:build-template": "node packages/create-jeco-framework/bin/create.js --dry-run"
  },
  "description": "Enterprise Playwright-based automation framework with custom reporting, fixtures and utilities.",
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "e2e",
    "framework"
  ],
  "homepage": "https://github.com/Jeco16/JecoFramework#readme",
  "bugs": {
    "url": "https://github.com/Jeco16/JecoFramework/issues"
  },
  "author": "Jacopo Enrico Marinaccio",
  "files": [
    "src/",
    "tests/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeco16/JecoFramework.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.38.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.5.0",
    "eslint-plugin-import": "^2.28.0"
  }
  ,
  "workspaces": [
    "packages/*"
  ]
}
